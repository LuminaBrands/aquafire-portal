---
import Base from '../layouts/Base.astro';

const tiles = [
  {
    id: 'getting-started',
    title: 'Getting Started',
    desc: 'New to Aquafire? Everything you need to know to plan, install, and enjoy your water vapor fireplace.',
    href: '/getting-started',
    icon: '&#x1f680;',
    span: 'wide',
    accent: 'red',
    cta: 'Start Here',
  },
  {
    id: 'enclosure',
    title: 'Enclosure Builder',
    desc: 'Interactive calculator for enclosure dimensions, cutout sizes, and light trap configuration.',
    href: '/enclosure-guide',
    icon: '&#x1f4d0;',
    span: 'normal',
    accent: 'amber',
    cta: 'Open Calculator',
  },
  {
    id: 'water-care',
    title: 'Water Care Guide',
    desc: 'Water hardness calculator and Vapor Pure softener setup for crystal-clear flames.',
    href: '/water-care',
    icon: '&#x1f4a7;',
    span: 'normal',
    accent: 'blue',
    cta: 'Check Water',
  },
  {
    id: 'quick-start',
    title: 'Quick Start Guides',
    desc: 'Step-by-step installation for every Aquafire model — Original, Pro, and Lite.',
    href: '/quick-start',
    icon: '&#x26a1;',
    span: 'normal',
    accent: 'amber',
    cta: 'View Guides',
  },
  {
    id: 'support',
    title: 'Support Hub',
    desc: 'Register your warranty, submit claims, troubleshooting guides, and FAQs.',
    href: '/support',
    icon: '&#x1f6e0;',
    span: 'normal',
    accent: 'red',
    cta: 'Get Help',
  },
  {
    id: 'accessories',
    title: 'Shop Accessories',
    desc: 'Complementary products, replacement parts, and everything to enhance your setup.',
    href: 'https://www.aquafire.com',
    icon: '&#x1f6d2;',
    span: 'normal',
    accent: 'amber',
    external: true,
    cta: 'Browse Shop',
  },
  {
    id: 'review',
    title: '"Absolutely stunning — guests always ask if it\'s real fire."',
    desc: '— Sarah M., Aquafire Pro owner',
    span: 'normal',
    accent: 'muted',
    type: 'testimonial',
  },
  {
    id: 'instagram',
    title: 'Follow @aquafire',
    desc: 'Design inspiration, installations, and behind-the-scenes.',
    href: 'https://www.instagram.com/aquafirefireplace/',
    icon: '&#x1f4f8;',
    span: 'normal',
    accent: 'gradient',
    external: true,
    cta: 'Instagram',
  },
  {
    id: 'youtube',
    title: 'Aquafire on YouTube',
    desc: 'Tutorials, install walkthroughs, and flame demos.',
    href: 'https://www.youtube.com/@AquafireFireplace',
    icon: '&#x25b6;',
    span: 'normal',
    accent: 'yt-red',
    external: true,
    cta: 'Watch Now',
  },
  {
    id: 'contact',
    title: 'Need a Custom Quote?',
    desc: 'Our team can help with custom enclosures, commercial projects, and bulk orders.',
    href: 'https://www.aquafire.com/pages/contact',
    icon: '&#x1f4ac;',
    span: 'wide',
    accent: 'red',
    external: true,
    cta: 'Contact Sales',
    type: 'cta',
  },
];
---

<Base title="Home">
  <!-- Hero -->
  <header class="hero">
    <div class="hero-glow"></div>
    <div class="container hero-content">
      <img
        src="https://cdn.shopify.com/s/files/1/0671/5562/4256/files/Primary-White2_6e02bdc0-bca1-4414-b4be-f79c24dbb7e0.png?v=1772644031"
        alt="Aquafire"
        class="hero-logo"
      />
      <h1>Your Complete Aquafire Guide</h1>
      <p class="hero-sub">Everything you need to plan, install, and maintain your water vapor fireplace.</p>
    </div>
  </header>

  <!-- Bento Grid -->
  <main class="container">
    <div class="bento">
      {tiles.map(tile => (
        <a
          href={tile.href || '#'}
          class:list={['bento-tile', `tile-${tile.span}`, `accent-${tile.accent}`, tile.type && `tile-${tile.type}`]}
          target={tile.external ? '_blank' : undefined}
          rel={tile.external ? 'noopener' : undefined}
        >
          {tile.icon && <span class="tile-icon" set:html={tile.icon} />}
          <h2 class="tile-title" set:html={tile.title} />
          <p class="tile-desc">{tile.desc}</p>
          {tile.cta && (
            <span class="tile-cta">
              {tile.cta}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          )}
        </a>
      ))}
    </div>
  </main>
</Base>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    overflow: hidden;
    padding: 56px 0 48px;
    text-align: center;
    background: linear-gradient(180deg, #241b1b 0%, var(--bg) 100%);
    border-bottom: 1px solid var(--border);
  }
  .hero-glow {
    position: absolute;
    top: -80px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 260px;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(200,40,40,0.14) 0%, transparent 70%);
    pointer-events: none;
  }
  .hero-content { position: relative; }
  .hero-logo {
    height: 28px;
    width: auto;
    margin-bottom: 16px;
    opacity: 0.7;
  }
  .hero h1 {
    font-size: 2.2rem;
    font-weight: 700;
    letter-spacing: -0.5px;
    line-height: 1.2;
  }
  .hero-sub {
    color: var(--text-muted);
    margin-top: 10px;
    font-size: 1rem;
  }

  /* ── Bento Grid ── */
  .bento {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin: 40px 0;
  }
  .tile-wide { grid-column: span 2; }

  /* ── Tile base ── */
  .bento-tile {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 28px 28px 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.2s, transform 0.15s, box-shadow 0.2s;
    position: relative;
    overflow: hidden;
  }
  .bento-tile:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.3);
  }

  /* Top accent bar */
  .bento-tile::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .bento-tile:hover::before { opacity: 1; }

  .accent-red::before   { background: var(--red); }
  .accent-red:hover     { border-color: rgba(192,57,43,0.3); }

  .accent-amber::before { background: var(--amber); }
  .accent-amber:hover   { border-color: rgba(232,168,56,0.3); }

  .accent-blue::before  { background: #3b82f6; }
  .accent-blue:hover    { border-color: rgba(59,130,246,0.3); }

  .accent-gradient::before { background: linear-gradient(90deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888); }
  .accent-gradient:hover   { border-color: rgba(220,39,67,0.3); }

  .accent-yt-red::before { background: #ff0000; }
  .accent-yt-red:hover   { border-color: rgba(255,0,0,0.25); }

  .accent-muted::before { background: var(--border); }
  .accent-muted:hover   { border-color: rgba(255,255,255,0.08); }

  /* ── Tile parts ── */
  .tile-icon {
    font-size: 1.6rem;
    line-height: 1;
    margin-bottom: 4px;
  }
  .tile-title {
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .tile-desc {
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.5;
    flex: 1;
  }
  .tile-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 600;
    margin-top: 4px;
    transition: gap 0.15s;
  }
  .bento-tile:hover .tile-cta { gap: 10px; }
  .accent-red .tile-cta   { color: var(--red); }
  .accent-amber .tile-cta { color: var(--amber); }
  .accent-blue .tile-cta  { color: #3b82f6; }
  .accent-gradient .tile-cta { color: #dc2743; }
  .accent-yt-red .tile-cta { color: #ff0000; }

  /* ── Testimonial tile ── */
  .tile-testimonial {
    justify-content: center;
    cursor: default;
  }
  .tile-testimonial .tile-title {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    font-weight: 500;
    font-style: italic;
    color: var(--text-muted);
    line-height: 1.5;
  }
  .tile-testimonial .tile-desc {
    font-size: 0.8rem;
    font-style: normal;
    margin-top: 4px;
  }
  .tile-testimonial:hover {
    transform: none;
    box-shadow: none;
  }

  /* ── CTA tile ── */
  .tile-cta-tile {
    background: linear-gradient(135deg, rgba(192,57,43,0.08) 0%, var(--surface) 100%);
    border-color: rgba(192,57,43,0.2);
    text-align: center;
    align-items: center;
  }
  .tile-cta-tile .tile-cta {
    background: var(--red);
    color: #fff;
    padding: 10px 28px;
    border-radius: var(--radius-sm);
    margin-top: 8px;
    font-size: 0.9rem;
  }
  .tile-cta-tile:hover .tile-cta {
    background: var(--red-dark);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .bento { grid-template-columns: repeat(2, 1fr); }
    .tile-wide { grid-column: span 2; }
  }

  @media (max-width: 560px) {
    .bento { grid-template-columns: 1fr; gap: 12px; }
    .tile-wide { grid-column: span 1; }
    .bento-tile { padding: 22px 20px 18px; }
    .hero h1 { font-size: 1.6rem; }
    .hero { padding: 40px 0 36px; }
  }
</style>
